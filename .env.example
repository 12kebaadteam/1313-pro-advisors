# ==============================================================================
# 1313 PRO ADVISORS LTD — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
#
# IMPORTANT SECURITY GUIDELINES:
# 1. Never commit `.env` or real credentials to GitHub.
# 2. Configure production credentials directly in Vercel Project Settings:
#    Vercel Dashboard > 1313-pro-advisors > Settings > Environment Variables
# 3. Server-side SMTP variables MUST NOT have the `VITE_` prefix to prevent them
#    from being exposed to browser bundles.
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVERLESS SMTP CONFIGURATION (GoDaddy Professional Email powered by Titan)
# Required for automated website enquiry notifications to office@1313proadvisors.ltd
# ------------------------------------------------------------------------------
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=office@1313proadvisors.ltd
SMTP_PASSWORD=CONFIGURE_SECURELY_IN_VERCEL
NOTIFICATION_EMAIL=office@1313proadvisors.ltd

# ------------------------------------------------------------------------------
# OPTIONAL CLIENT-SIDE ENVIRONMENT VARIABLES (Vite Frontend)
# ------------------------------------------------------------------------------
# Canonical Production Domain Override (Defaults to https://1313proadvisors.ltd)
# VITE_SITE_URL=https://1313proadvisors.ltd

# Google Search Console Verification Tag
# VITE_GOOGLE_SITE_VERIFICATION=your_gsc_verification_code_here
